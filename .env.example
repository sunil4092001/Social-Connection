# Copy to .env (never commit .env) or run:  ./scripts/new-docker-env.ps1
# Used by docker-compose.yml.

# HMAC key for JWTs, shared by all services. At least 32 characters.
JWT_KEY=change-me-to-a-long-random-value-of-at-least-32-characters
# Shared secret between IdentityService and UserService for the registration handoff.
INTERNAL_SERVICE_KEY=change-me-too
POSTGRES_PASSWORD=change-me
# SQL Server requires upper case, lower case, digits and symbols, 8+ characters.
SQLSERVER_PASSWORD=Change-Me-123
NEO4J_PASSWORD=change-me-neo4j

{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    // Api gateway routing configuration
    "ReverseProxy": {
        "Routes": {
            "identityRoute": {
                "ClusterId": "identityCluster",
                "Match": {
                    "Path": "/api/auth/{**catch-all}"
                    //"Path": "/api/profile/{**catch-all}"
                }
            },
            "productRoute": {
                "ClusterId": "productCluster",
                "Match": {
                    "Path": "/api/products/{**catch-all}"
                }
            },
            "userRoute": {
                "ClusterId": "userCluster",
                "Match": {
                    "Path": "/api/users/{**catch-all}"
                }
            },
                "skillRoute": {
                    "ClusterId": "userCluster",
                    "Match": {
                        "Path": "/api/skills/{**catch-all}"
                    }
                },
                "requirementRoute": {
                    "ClusterId": "requirementCluster",
                    "Match": {
                        "Path": "/api/requirements/{**catch-all}"
                    }
                },
            "postRoute": {
                "ClusterId": "postCluster",
                "Match": {
                    "Path": "/api/posts/{**catch-all}"
                }
            },
            "commentRoute": {
                "ClusterId": "postCluster",
                "Match": {
                    "Path": "/api/comments/{**catch-all}"
                }
            },

            "connectionRoute": {
                "ClusterId": "connectionCluster",
                "Match": {
                    "Path": "/api/connections/{**catch-all}"
                }
            },
            "notificationRoute": {
                "ClusterId": "notificationCluster",
                "Match": {
                    "Path": "/api/notifications/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "identityCluster": {
                "Destinations": {
                    "d1": {
                        "Address": "http://localhost:5169/"
                    }

                }
            },
            "productCluster": {
                "Destinations": {
                    "d1": {
                        "Address": "https://localhost:6001/"
                    }
                }
            },
            "userCluster": {
                "Destinations": {
                    "d1": {
                        //"Address": "http://localhost:7245/"
                        "Address": "http://localhost:5079/"
                    }
                }
            },
            "postCluster": {
                "Destinations": {
                    "d1": {
                        "Address": "http://localhost:5107/"
                    }
                }
            },
            "connectionCluster": {
                "Destinations": {
                    "d1": {
                        "Address": "http://localhost:5155/"
                    }
                }
            },
            "notificationCluster": {
                "Destinations": {
                    "d1": {
                        "Address": "http://localhost:5080/"
                    }
                }
            },
                "requirementCluster": {
                    "Destinations": {
                        "d1": {
                            "Address": "http://localhost:56661/"
                        }
                    }
                }
        }
    },
    //serilog

    "Seq": {
        "ServerUrl": "http://localhost:5341"
    },

    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning"
            }
        }
    }
}
